# ==================== Firebase (auth + Firestore) ====================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ==================== Gemini (video analysis) + GCS ====================
# Project that hosts the GCS bucket and Gemini API access.
GOOGLE_CLOUD_PROJECT=nxt-acad-hackathon-dev
# Gemini API location (use global for enterprise Gemini, us-central1 for Vertex).
GOOGLE_CLOUD_LOCATION=global
# Bucket where uploaded submission videos are stored (must already exist).
EVALUATION_BUCKET_NAME=nxt-acad-hackathon-ls-prod-hackathon-evaluations-dev
# Multimodal Gemini model used to analyze submission videos.
GEMINI_MODEL=gemini-3.5-flash
# Use enterprise Gemini client (matches the VideoAnalyzer prototype).
GEMINI_ENTERPRISE=true
# Output-token caps per task. Defaults match the JSON each task is asked to
# return, plus room to think. They are not measured from production traffic.
# The cap includes thinking tokens. A cut-off reply is retried once at the ceiling.
# GEMINI_MAX_OUTPUT_TOKENS_CHECKLIST=8192
# GEMINI_MAX_OUTPUT_TOKENS_FIELD_SCORE=4096
# GEMINI_MAX_OUTPUT_TOKENS_PROBLEM=4096
# GEMINI_MAX_OUTPUT_TOKENS_SOLUTION=4096
# GEMINI_MAX_OUTPUT_TOKENS_VIDEO=8192
# GEMINI_MAX_OUTPUT_TOKENS_SUMMARY=2048
# GEMINI_MAX_OUTPUT_TOKENS_GITHUB=4096
# GEMINI_MAX_OUTPUT_TOKENS_CEILING=8192
# Explicit context cache for scoring rules. Off unless the stable rule text
# is at least GEMINI_CACHE_MIN_TOKENS (Gemini 3 floor is about 4096). Student
# answers are never cached. Set GEMINI_CONTEXT_CACHE=off to disable creates.
# GEMINI_CONTEXT_CACHE=auto
# GEMINI_CACHE_MIN_TOKENS=4096
# GEMINI_CACHE_TTL_SECONDS=3600
# Demo video is sent as the existing gs:// object. Default sampling is 1 frame
# per second at low resolution (the documented general-video setting). Values
# below 1 are raised to 1 so a second of the demo is not skipped. Audio is
# left in the file. A repeat of the same file and rubric reuses the report.
# GEMINI_VIDEO_MEDIA_RESOLUTION=low
# GEMINI_VIDEO_FPS=1
# In-process retries for quota and unavailable errors. Validation errors are
# not retried. Cloud Tasks still retries a worker that dies mid-request.
# GEMINI_RETRY_ATTEMPTS=3
# Master switch. false skips every Gemini call (local, tests, or a paused event).
# Daily budgets of 0 mean unlimited. They are per process, not a Cloud Billing cap.
# GEMINI_ENABLED=true
# GEMINI_DAILY_REQUEST_BUDGET=0
# GEMINI_DAILY_TOKEN_BUDGET=0
# GEMINI_BUDGET_ALERT_RATIO=0.8
# GEMINI_MAX_CONCURRENT=4
# GEMINI_MAX_EVALUATIONS_PER_SUBMISSION=0
# Expiry (seconds) for signed HTTPS video URLs returned in submission responses.
VIDEO_SIGNED_URL_EXPIRY_SECONDS=3600

# Google Drive folder id for admin submission exports (see README).
# Create a folder as a user, share with FIREBASE_CLIENT_EMAIL as Editor.
# GOOGLE_SHEETS_EXPORT_FOLDER_ID=your_drive_folder_id

# External GitHub repository AI analyzer (Repo Analysis microservice).
# Base URL or /docs — backend POSTs /analyze then polls GET /analyze/{job_id}.
GITHUB_AI_EVALUATION_URL=https://github-analyser-361821886421.us-central1.run.app
# GITHUB_AI_EVALUATION_API_KEY=optional_bearer_token
# GITHUB_AI_EVALUATION_WAIT_SECONDS=120
# GITHUB_AI_EVALUATION_TIMEOUT_SECONDS=130
# GITHUB_AI_EVALUATION_MAX_POLLS=3

# ==================== Durable evaluation jobs (Phase 2) ====================
# auto = Cloud Tasks when queue+target+secret are set, else BackgroundTasks (local default)
EVALUATION_JOB_MODE=auto
# Leave unset locally to use FastAPI BackgroundTasks (same UX, not durable across restarts).
# CLOUD_TASKS_LOCATION=asia-south1
# CLOUD_TASKS_QUEUE=evaluation-jobs
# CLOUD_TASKS_TARGET_URL=https://YOUR_CLOUD_RUN_URL/internal/jobs/evaluate-submission
# Optional second worker. When both URLs are set, Application Settings can
# choose the personal project, the company project, or both. Both uses a share
# (default 4 personal, then 1 company). GitHub AI is unchanged.
# CLOUD_TASKS_COMPANY_TARGET_URL=https://YOUR_COMPANY_EVALUATOR_URL/internal/jobs/evaluate-submission
# INTERNAL_JOB_SECRET=generate-a-long-random-string

# ==================== Application ====================
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://challzo.vercel.app
# Production (cross-origin Vercel frontend): set to your frontend URL, e.g.
# ALLOWED_ORIGINS=https://challazo.in
# Cookie SameSite: lax (local HTTP) or none (cross-origin prod + Secure cookie)
COOKIE_SAMESITE=lax

# ==================== Auth hardening (Phase 5) ====================
# 5a: revoked-token checks are always on (no env flag).
# 5b: SPA must send X-CSRF-Token matching the csrf_token cookie on mutating requests.
# Cross-origin (Vercel → Cloud Run): read csrf_token from login JSON or GET /auth/csrf,
# not document.cookie (API cookies are not visible on the frontend origin).
CSRF_PROTECTION=true
# 5c: SPA must send current_password on POST /auth/change-password.
REQUIRE_CURRENT_PASSWORD_ON_CHANGE=true
# Optional: CORS allow-lists (Phase 12 defaults match the SPA; * restores wildcards).
# CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
# CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With,X-CSRF-Token,Range
# CORS_EXPOSE_HEADERS=Content-Range,Accept-Ranges,Content-Length
# Enable Swagger in production only if needed (default off when ENVIRONMENT=production).
# ENABLE_API_DOCS=false

# ==================== Deploy / ops (Phase 8) ====================
# Seed default admin/evaluator/student on startup (same as historical behaviour).
# Set false in prod once bootstrap accounts exist.
SEED_ON_STARTUP=true

# ==================== Student registration verification ====================
# SHA-256 pepper for email OTP hashes (defaults to FIREBASE_PROJECT_ID).
OTP_PEPPER=change-me-in-production
#
# Email OTP delivery (student registration):
#   console   — log OTP in server stdout (default when ENVIRONMENT=development)
#   smtp      — send via Brevo SMTP (recommended for staging + production Cloud Run)
#   firestore — queue in Firestore `mail` for Firebase Trigger Email extension
#
# EMAIL_PROVIDER=smtp
#
# --- Brevo SMTP (https://app.brevo.com → SMTP & API → Generate SMTP key) ---
# Server: smtp-relay.brevo.com  Port: 587 (STARTTLS) or 465 (set SMTP_USE_SSL=true)
# SMTP_USERNAME = Brevo SMTP login (same as verified sender for this project)
# SMTP_PASSWORD = the SMTP key (not your Brevo account password)
# SMTP_FROM / MAIL_FROM = verified sender in Brevo (Senders & IP → Senders)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@mail.nxtlab.tech
# SMTP_PASSWORD=xsmtpsib-xxxxxxxx
# SMTP_FROM=noreply@mail.nxtlab.tech
# MAIL_FROM=noreply@mail.nxtlab.tech
# SMTP_FROM_NAME=Challazo
# SMTP_USE_SSL=false
#
# Concurrent registration (campus Wi-Fi / shared NAT):
# Per-email cap stays 5 OTP sends/hour. Per-IP default is 2000/hour so 60–500
# people on the same network are not blocked after 5 total sends.
# Set OTP_MAX_SENDS_PER_IP_PER_HOUR=0 to disable the IP cap.
# OTP_MAX_SENDS_PER_EMAIL_PER_HOUR=5
# OTP_MAX_SENDS_PER_IP_PER_HOUR=2000

# ==================== Server ====================
HOST=0.0.0.0
PORT=8000
